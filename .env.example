# =============================================================================
# VARIABLES DE ENTORNO DE REFERENCIA (CONFYTICKETS)
# Copiar este archivo a .env y ajustar según el entorno local/producción
# =============================================================================

# --- ENTORNO GENERAL ---
PROJECT_NAME="ConfyTickets"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3010","http://localhost:3020","http://localhost:3030","http://127.0.0.1:3010","http://127.0.0.1:3020","http://127.0.0.1:3030","capacitor://localhost","http://localhost"]

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="confy_admin"
POSTGRES_PASSWORD="confy_secure_password_2026"
POSTGRES_DB="confytickets_db"
DATABASE_URL="postgresql+asyncpg://confy_admin:confy_secure_password_2026@localhost:5432/confytickets_db"

# --- REDIS Y CELERY (CACHE & ASYNC WORKERS) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# --- AUTENTICACIÓN SUPABASE AUTH ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- MENSAJERÍA PUSH (FIREBASE CLOUD MESSAGING) ---
FIREBASE_CREDENTIALS_PATH="./infrastructure/secrets/firebase-service-account.json"

# --- FRONTEND URLS (PARA CORREOS Y REDIRECCIONES) ---
CUSTOMER_WEB_URL="http://localhost:3010"
ADMIN_WEB_URL="http://localhost:3020"
